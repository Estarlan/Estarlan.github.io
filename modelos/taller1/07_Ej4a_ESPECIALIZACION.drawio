<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="07-Ej4a_Especializacio" name="07-Ej4a Especializacion OPERARIO"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c216" value="Ejercicio 4a - Especializacion OPERARIO (jerarquia parcial y solapada)" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c217" value="OPERARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="220" width="200" height="62" as="geometry"/></mxCell><mxCell id="c218" value="&lt;u&gt;id_operario&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="160" height="46" as="geometry"/></mxCell><mxCell id="c219" style="html=1;endArrow=none;" edge="1" parent="1" source="c218" target="c217"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c220" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="160" height="46" as="geometry"/></mxCell><mxCell id="c221" style="html=1;endArrow=none;" edge="1" parent="1" source="c220" target="c217"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c222" value="licencia_portuaria" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="160" height="46" as="geometry"/></mxCell><mxCell id="c223" style="html=1;endArrow=none;" edge="1" parent="1" source="c222" target="c217"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c224" value="SER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="165" height="82" as="geometry"/></mxCell><mxCell id="c225" value="SER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="165" height="82" as="geometry"/></mxCell><mxCell id="c226" value="GRUERO" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="620" width="215" height="68" as="geometry"/></mxCell><mxCell id="c227" value="ESTIBADOR" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="620" width="215" height="68" as="geometry"/></mxCell><mxCell id="c228" value="horas_operacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="160" height="46" as="geometry"/></mxCell><mxCell id="c229" style="html=1;endArrow=none;" edge="1" parent="1" source="c228" target="c226"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c230" value="tipo_certificacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="690" width="160" height="46" as="geometry"/></mxCell><mxCell id="c231" style="html=1;endArrow=none;" edge="1" parent="1" source="c230" target="c226"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c232" value="&lt;u&gt;id_operario&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="160" height="46" as="geometry"/></mxCell><mxCell id="c233" style="html=1;endArrow=none;" edge="1" parent="1" source="c232" target="c226"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c234" value="examen_medico_vigente" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="620" width="160" height="46" as="geometry"/></mxCell><mxCell id="c235" style="html=1;endArrow=none;" edge="1" parent="1" source="c234" target="c227"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c236" value="&lt;u&gt;id_operario&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="730" width="160" height="46" as="geometry"/></mxCell><mxCell id="c237" style="html=1;endArrow=none;" edge="1" parent="1" source="c236" target="c227"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c238" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c217" target="c224"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c239" value="(1) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c224" target="c226"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c240" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c217" target="c225"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c241" value="(1) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c225" target="c227"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c242" value="MANEJAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="945" y="890" width="165" height="82" as="geometry"/></mxCell><mxCell id="c243" value="EQUIPO_ESTIBADOR" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="1080" width="215" height="68" as="geometry"/></mxCell><mxCell id="c244" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;equipo&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1090" width="170" height="46" as="geometry"/></mxCell><mxCell id="c245" style="html=1;endArrow=none;" edge="1" parent="1" source="c244" target="c243"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c246" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c227" target="c242"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c247" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c242" target="c243"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c248" value="equipos_manejados era multivaluado:&lt;br&gt;se extrae a EQUIPO_ESTIBADOR.&lt;br&gt;Clave: &lt;b&gt;id_operario + equipo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="1090" width="350" height="70" as="geometry"/></mxCell><mxCell id="c249" value="&lt;b&gt;Regla aplicada: especializacion&lt;/b&gt;&lt;br&gt;La jerarquia se sustituye por una &lt;b&gt;relacion binaria 1:1&lt;/b&gt; entre la superclase y cada subclase. Cada subclase queda como entidad que hereda id_operario como clave.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt; OPERARIO (1) parcial - GRUERO (1) total; OPERARIO (1) parcial - ESTIBADOR (1) total.&lt;br&gt;&lt;br&gt;&lt;b&gt;Como se refleja que es PARCIAL.&lt;/b&gt; La participacion de OPERARIO en ambas relaciones SER es &lt;b&gt;parcial&lt;/b&gt; (linea simple): hay operarios que no son ni grueros ni estibadores. El lado de la subclase es total: todo gruero es un operario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Como se refleja que es SOLAPADA.&lt;/b&gt; Son &lt;b&gt;dos relaciones independientes&lt;/b&gt;, no una sola con opciones excluyentes. Nada impide que el mismo id_operario aparezca a la vez en GRUERO y en ESTIBADOR.&lt;br&gt;&lt;br&gt;&lt;b&gt;Estrategia descartada por el solapamiento.&lt;/b&gt; Queda descartada la &lt;b&gt;tabla unica con atributo discriminante&lt;/b&gt; (un solo campo tipo_operario). Un campo de un solo valor no puede decir que un operario es gruero Y estibador al mismo tiempo: forzaria exclusividad, lo contrario de una jerarquia solapada. Por la parcialidad tambien queda descartada la estrategia de solo-subclases, que dejaria sin representacion a los operarios que no pertenecen a ninguna.&lt;br&gt;&lt;br&gt;&lt;b&gt;equipos_manejados.&lt;/b&gt; Es multivaluado, asi que se extrae a la entidad debil EQUIPO_ESTIBADOR, unida a ESTIBADOR por una relacion 1:N. Clave: &lt;b&gt;id_operario + equipo&lt;/b&gt;. Participacion: ESTIBADOR (1) parcial - EQUIPO_ESTIBADOR (N) total." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="160" width="510" height="940" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>