<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="00-Leyenda" name="00-Leyenda"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Leyenda - notacion de Peter Chen usada en todos los modelos" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c2" value="ENTIDAD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="200" height="62" as="geometry"/></mxCell><mxCell id="c3" value="Rectangulo simple: entidad fuerte. Se nombra con un sustantivo en singular." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="108" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c4" value="ENTIDAD" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="178" width="200" height="62" as="geometry"/></mxCell><mxCell id="c5" value="Rectangulo doble: entidad debil. No tiene clave propia completa; hereda la de otra." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="196" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c6" value="RELACIONAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="266" width="200" height="62" as="geometry"/></mxCell><mxCell id="c7" value="Rombo: relacion. Se nombra con un verbo en infinitivo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="284" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c8" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="354" width="200" height="62" as="geometry"/></mxCell><mxCell id="c9" value="Elipse simple: atributo simple." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="372" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;u&gt;clave&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="442" width="200" height="62" as="geometry"/></mxCell><mxCell id="c11" value="Elipse con subrayado continuo: atributo clave." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="460" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;parcial&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="530" width="200" height="62" as="geometry"/></mxCell><mxCell id="c13" value="Elipse con subrayado punteado: clave parcial de una entidad debil." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="548" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Cardinalidad y participacion en las lineas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="638" width="800" height="24" as="geometry"/></mxCell><mxCell id="c15" value="ENTIDAD_A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="678" width="200" height="62" as="geometry"/></mxCell><mxCell id="c16" value="RELACIONAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="668" width="165" height="82" as="geometry"/></mxCell><mxCell id="c17" value="ENTIDAD_B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="678" width="200" height="62" as="geometry"/></mxCell><mxCell id="c18" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Linea simple = participacion parcial (minimo 0).&lt;br&gt;Linea doble = participacion total (minimo 1).&lt;br&gt;El numero entre parentesis es la cardinalidad maxima de ese extremo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="678" width="500" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Alcance.&lt;/b&gt; Cada archivo contiene el fragmento del modelo entidad-relacion &lt;b&gt;transformado&lt;/b&gt; que resuelve un punto del taller, con todos los atributos de las entidades que intervienen, y la justificacion de la regla aplicada. En el modelo transformado no quedan atributos compuestos, multivaluados ni derivados, ni relaciones N:M, ternarias, de agregacion o de especializacion: solo entidades, atributos simples y relaciones binarias 1:1 y 1:N." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="818" width="1360" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>