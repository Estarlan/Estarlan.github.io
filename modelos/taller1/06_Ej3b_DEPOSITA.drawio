dth="160" height="46" as="geometry"/></mxCell><mxCell id="c193" style="html=1;endArrow=none;" edge="1" parent="1" source="c192" target="c187"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c194" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c175" target="c184"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c195" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c184" target="c185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c196" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c185" target="c186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c197" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c186" target="c187"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c198" value="tipo_carga" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="160" height="46" as="geometry"/></mxCell><mxCell id="c199" style="html=1;endArrow=none;" edge="1" parent="1" source="c198" target="c185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c200" value="peso_toneladas" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="160" height="46" as="geometry"/></mxCell><mxCell id="c201" style="html=1;endArrow=none;" edge="1" parent="1" source="c200" target="c185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c202" value="fecha_solicitud" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="160" height="46" as="geometry"/></mxCell><mxCell id="c203" style="html=1;endArrow=none;" edge="1" parent="1" source="c202" target="c185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c204" value="ALMACENAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="560" width="165" height="82" as="geometry"/></mxCell><mxCell id="c205" value="BODEGA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="645" y="780" width="200" height="62" as="geometry"/></mxCell><mxCell id="c206" value="&lt;u&gt;codigo_bodega&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="840" width="160" height="46" as="geometry"/></mxCell><mxCell id="c207" style="html=1;endArrow=none;" edge="1" parent="1" source="c206" target="c205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c208" value="zona" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="930" width="160" height="46" as="geometry"/></mxCell><mxCell id="c209" style="html=1;endArrow=none;" edge="1" parent="1" source="c208" target="c205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c210" value="capacidad_m2" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="840" width="160" height="46" as="geometry"/></mxCell><mxCell id="c211" style="html=1;endArrow=none;" edge="1" parent="1" source="c210" target="c205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c212" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c185" target="c204"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c213" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c204" target="c205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c214" value="Clave de EMBARQUE: &lt;b&gt;documento + codigo_servicio + fecha_arribo&lt;/b&gt;&lt;br&gt;(heredada de IMPORTADOR y de RECALADA; ver Ejercicio 2a)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="500" width="460" height="50" as="geometry"/></mxCell><mxCell id="c215" value="&lt;b&gt;Regla aplicada: agregacion&lt;/b&gt;&lt;br&gt;Una agregacion trata una relacion completa como si fuera una entidad, para poder relacionarla con otra. El modelo transformado no admite agregaciones. Como la relacion agregada (EMBARQUE) ya fue convertida en entidad en el ejercicio 2a, la agregacion desaparece sola: la nueva relacion se dibuja &lt;b&gt;contra esa entidad&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sobre que queda apoyada.&lt;/b&gt; Sobre la entidad EMBARQUE, el unico elemento del modelo transformado que representa 'la participacion de un importador en una recalada'.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que no puede dibujarse contra IMPORTADOR.&lt;/b&gt; Diria que un importador se almacena siempre en la misma bodega, sin importar la recalada. Se perderia el hecho de que usa bodegas distintas en escalas distintas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que no puede dibujarse contra RECALADA.&lt;/b&gt; Diria que toda la carga de una recalada va a una sola bodega. Se perderia la separacion por importador cuando varios embarcan en la misma escala.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt; EMBARQUE (N) total - BODEGA (1) parcial. Todo embarque se deposita en exactamente una bodega; una bodega puede estar vacia y recibe muchos embarques con el tiempo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nota.&lt;/b&gt; codigo_bodega NO forma parte de la clave de EMBARQUE: es un dato descriptivo. EMBARQUE ya tiene clave completa antes de relacionarse con BODEGA." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="160" width="460" height="880" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>