dth="170" height="46" as="geometry"/></mxCell><mxCell id="c148" style="html=1;endArrow=none;" edge="1" parent="1" source="c147" target="c146"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c149" value="hora_arribo" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="160" height="46" as="geometry"/></mxCell><mxCell id="c150" style="html=1;endArrow=none;" edge="1" parent="1" source="c149" target="c146"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c151" value="estado" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="160" height="46" as="geometry"/></mxCell><mxCell id="c152" style="html=1;endArrow=none;" edge="1" parent="1" source="c151" target="c146"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c153" value="SUMINISTRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="200" height="62" as="geometry"/></mxCell><mxCell id="c154" value="&lt;u&gt;codigo_suministro&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="160" height="46" as="geometry"/></mxCell><mxCell id="c155" style="html=1;endArrow=none;" edge="1" parent="1" source="c154" target="c153"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c156" value="descripcion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="310" width="160" height="46" as="geometry"/></mxCell><mxCell id="c157" style="html=1;endArrow=none;" edge="1" parent="1" source="c156" target="c153"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c158" value="unidad_medida" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="310" width="160" height="46" as="geometry"/></mxCell><mxCell id="c159" style="html=1;endArrow=none;" edge="1" parent="1" source="c158" target="c153"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c160" value="ABASTECER" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="700" width="215" height="68" as="geometry"/></mxCell><mxCell id="c161" value="cantidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="890" width="160" height="46" as="geometry"/></mxCell><mxCell id="c162" style="html=1;endArrow=none;" edge="1" parent="1" source="c161" target="c160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c163" value="SURTIR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="165" height="82" as="geometry"/></mxCell><mxCell id="c164" value="CORRESPONDER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="430" width="165" height="82" as="geometry"/></mxCell><mxCell id="c165" value="INCLUIR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="580" width="165" height="82" as="geometry"/></mxCell><mxCell id="c166" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c141" target="c163"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c167" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c163" target="c160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c168" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c146" target="c164"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c169" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c164" target="c160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c170" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c153" target="c165"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c171" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c165" target="c160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c172" value="Clave de ABASTECER: &lt;b&gt;nit + codigo_servicio + fecha_arribo + codigo_suministro&lt;/b&gt;&lt;br&gt;codigo_servicio llega desde SERVICIO, del que RECALADA depende (ver Ejercicio 2a).&lt;br&gt;El atributo sede de CONTRATISTA quedo transformado en el Ejercicio 1b." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="990" width="700" height="80" as="geometry"/></mxCell><mxCell id="c173" value="&lt;b&gt;Regla aplicada: relacion ternaria&lt;/b&gt;&lt;br&gt;El modelo transformado solo admite relaciones binarias. Una ternaria se sustituye por una &lt;b&gt;entidad&lt;/b&gt; que la representa, conectada por &lt;b&gt;tres relaciones binarias 1:N&lt;/b&gt;, una hacia cada entidad participante. El atributo cantidad queda dentro de esa entidad, porque depende de las tres a la vez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Clave de ABASTECER&lt;/b&gt;&lt;br&gt;&lt;b&gt;nit + codigo_servicio + fecha_arribo + codigo_suministro&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que intervienen los tres identificadores.&lt;/b&gt; La cardinalidad es M:N:N: ninguna combinacion de dos entidades determina a la tercera. Un mismo suministro puede ser entregado por varios contratistas en la misma recalada, luego (recalada, suministro) no basta para distinguir una entrega. Solo la terna completa identifica un hecho unico. Como RECALADA es debil, aporta sus dos componentes y la clave termina con cuatro atributos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt; CONTRATISTA (1) parcial - ABASTECER (N) total; RECALADA (1) parcial - ABASTECER (N) total; SUMINISTRO (1) parcial - ABASTECER (N) total.&lt;br&gt;&lt;br&gt;&lt;b&gt;Que cambiaria con un unico contratista por recalada y suministro.&lt;/b&gt; La cardinalidad pasaria a M:N:1 respecto de CONTRATISTA: la pareja (recalada, suministro) determinaria al contratista. La clave se reduciria a &lt;b&gt;codigo_servicio + fecha_arribo + codigo_suministro&lt;/b&gt;, y nit dejaria de ser parte de la clave para quedar como &lt;b&gt;atributo descriptivo&lt;/b&gt; de ABASTECER." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="160" width="500" height="900" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>