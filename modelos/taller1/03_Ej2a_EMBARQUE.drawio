e="1" parent="1" source="c66" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c76" value="PERTENECER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="560" width="165" height="82" as="geometry"/></mxCell><mxCell id="c77" value="EMBARQUE" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="760" width="215" height="68" as="geometry"/></mxCell><mxCell id="c78" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c67" target="c76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c79" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c76" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c80" value="tipo_carga" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="950" width="160" height="46" as="geometry"/></mxCell><mxCell id="c81" style="html=1;endArrow=none;" edge="1" parent="1" source="c80" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c82" value="peso_toneladas" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="1010" width="160" height="46" as="geometry"/></mxCell><mxCell id="c83" style="html=1;endArrow=none;" edge="1" parent="1" source="c82" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c84" value="fecha_solicitud" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="950" width="160" height="46" as="geometry"/></mxCell><mxCell id="c85" style="html=1;endArrow=none;" edge="1" parent="1" source="c84" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c86" value="IMPORTADOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="200" height="62" as="geometry"/></mxCell><mxCell id="c87" value="&lt;u&gt;documento&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="160" height="46" as="geometry"/></mxCell><mxCell id="c88" style="html=1;endArrow=none;" edge="1" parent="1" source="c87" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c89" value="nombres" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="160" height="46" as="geometry"/></mxCell><mxCell id="c90" style="html=1;endArrow=none;" edge="1" parent="1" source="c89" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c91" value="apellidos" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="160" height="46" as="geometry"/></mxCell><mxCell id="c92" style="html=1;endArrow=none;" edge="1" parent="1" source="c91" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c93" value="fecha_registro" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1000" width="160" height="46" as="geometry"/></mxCell><mxCell id="c94" style="html=1;endArrow=none;" edge="1" parent="1" source="c93" target="c86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c95" value="REALIZAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="750" width="165" height="82" as="geometry"/></mxCell><mxCell id="c96" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c86" target="c95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c97" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c95" target="c77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c98" value="Clave de EMBARQUE: &lt;b&gt;documento + codigo_servicio + fecha_arribo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="870" width="460" height="30" as="geometry"/></mxCell><mxCell id="c99" value="&lt;b&gt;Regla aplicada: relacion N:M con atributos&lt;/b&gt;&lt;br&gt;Una relacion N:M no sobrevive al modelo transformado, y sus atributos no pertenecen a ninguno de los dos extremos. Se sustituye por una &lt;b&gt;entidad intermedia&lt;/b&gt; (EMBARQUE) unida a cada entidad original por una &lt;b&gt;relacion binaria 1:N&lt;/b&gt;. Los atributos de la relacion pasan a ser atributos de esa entidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;EMBARQUE es entidad debil.&lt;/b&gt; No tiene identificador propio: depende en identificacion de &lt;b&gt;IMPORTADOR y de RECALADA&lt;/b&gt; a la vez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Clave de EMBARQUE.&lt;/b&gt; RECALADA es a su vez debil respecto de SERVICIO, asi que su identificador completo es (codigo_servicio, fecha_arribo). Por lo tanto la clave de EMBARQUE es &lt;b&gt;documento + codigo_servicio + fecha_arribo&lt;/b&gt;: tres componentes, no dos. La debilidad se propaga en cadena.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt;&lt;br&gt;&#8226; IMPORTADOR (1) parcial - EMBARQUE (N) total.&lt;br&gt;&#8226; RECALADA (1) parcial - EMBARQUE (N) total.&lt;br&gt;El lado de la entidad debil siempre es total: un embarque no existe sin su importador y su recalada. El lado fuerte es parcial: puede haber importadores sin embarques y recaladas sin carga.&lt;br&gt;&lt;br&gt;Se dibuja tambien SERVICIO - IDENTIFICAR - RECALADA porque sin esa parte no puede justificarse la clave. El atributo correo de IMPORTADOR no aparece aqui: quedo transformado en el ejercicio 1a." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="580" height="900" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>