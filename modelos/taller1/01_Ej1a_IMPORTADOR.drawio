<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="01-Ej1a_Atributos_de_I" name="01-Ej1a Atributos de IMPORTADOR"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c22" value="Ejercicio 1a - Transformacion de los atributos de IMPORTADOR" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c23" value="IMPORTADOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="200" height="62" as="geometry"/></mxCell><mxCell id="c24" value="&lt;u&gt;documento&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="160" height="46" as="geometry"/></mxCell><mxCell id="c25" style="html=1;endArrow=none;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="nombres" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="160" height="46" as="geometry"/></mxCell><mxCell id="c27" style="html=1;endArrow=none;" edge="1" parent="1" source="c26" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="apellidos" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="140" width="160" height="46" as="geometry"/></mxCell><mxCell id="c29" style="html=1;endArrow=none;" edge="1" parent="1" source="c28" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="fecha_registro" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="220" width="160" height="46" as="geometry"/></mxCell><mxCell id="c31" style="html=1;endArrow=none;" edge="1" parent="1" source="c30" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="TENER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="590" width="165" height="82" as="geometry"/></mxCell><mxCell id="c33" value="CORREO_IMPORTADOR" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="555" y="780" width="215" height="68" as="geometry"/></mxCell><mxCell id="c34" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;correo&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="790" width="170" height="46" as="geometry"/></mxCell><mxCell id="c35" style="html=1;endArrow=none;" edge="1" parent="1" source="c34" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c23" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="Eliminados del modelo:&lt;br&gt;&#8226; nombre_completo (compuesto) - se conservan sus componentes.&lt;br&gt;&#8226; antiguedad_cliente (derivado) - se calcula desde fecha_registro." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="800" width="400" height="90" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Reglas aplicadas&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Atributo compuesto (nombre_completo).&lt;/b&gt; Se elimina el atributo padre y se dejan solo sus componentes simples: nombres y apellidos.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Atributo multivaluado (correo).&lt;/b&gt; Se extrae a la entidad CORREO_IMPORTADOR, unida a IMPORTADOR por la relacion 1:N TENER.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Atributo derivado (antiguedad_cliente).&lt;/b&gt; Se elimina: se calcula desde fecha_registro.&lt;br&gt;&lt;br&gt;&lt;b&gt;Entidad debil.&lt;/b&gt; CORREO_IMPORTADOR no tiene identificador propio. Clave parcial: &lt;i&gt;correo&lt;/i&gt;. Clave completa: &lt;b&gt;documento + correo&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt;&lt;br&gt;&#8226; IMPORTADOR (1) parcial: puede no tener correos registrados.&lt;br&gt;&#8226; CORREO_IMPORTADOR (N) total: sin importador no existe." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="160" width="540" height="620" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>