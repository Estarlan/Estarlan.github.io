<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="08-Ej4b_SUPERVISAR_y_T" name="08-Ej4b SUPERVISAR y TRANSBORDAR"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c250" value="Ejercicio 4b - Relaciones recursivas: cual se transforma y cual no" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c251" value="&lt;b&gt;SUPERVISAR (M:N recursiva) - SI se transforma&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="700" height="26" as="geometry"/></mxCell><mxCell id="c252" value="OPERARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="190" width="200" height="62" as="geometry"/></mxCell><mxCell id="c253" value="&lt;u&gt;id_operario&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="160" height="46" as="geometry"/></mxCell><mxCell id="c254" style="html=1;endArrow=none;" edge="1" parent="1" source="c253" target="c252"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c255" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="160" height="46" as="geometry"/></mxCell><mxCell id="c256" style="html=1;endArrow=none;" edge="1" parent="1" source="c255" target="c252"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c257" value="licencia_portuaria" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="160" height="46" as="geometry"/></mxCell><mxCell id="c258" style="html=1;endArrow=none;" edge="1" parent="1" source="c257" target="c252"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c259" value="SUPERVISAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="350" width="165" height="82" as="geometry"/></mxCell><mxCell id="c260" value="SER_SUPERVISADO" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="350" width="165" height="82" as="geometry"/></mxCell><mxCell id="c261" value="SUPERVISION" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="530" width="215" height="68" as="geometry"/></mxCell><mxCell id="c262" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;periodo&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="545" width="170" height="46" as="geometry"/></mxCell><mxCell id="c263" style="html=1;endArrow=none;" edge="1" parent="1" source="c262" target="c261"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c264" value="rol supervisor  (1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c252" target="c259"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c265" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c259" target="c261"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c266" value="rol supervisado  (1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c252" target="c260"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c267" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c260" target="c261"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c268" value="Clave de SUPERVISION: &lt;b&gt;id_operario(supervisor) + id_operario(supervisado) + periodo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="700" height="30" as="geometry"/></mxCell><mxCell id="c269" value="&lt;b&gt;TRANSBORDAR (1:N recursiva) - NO se transforma&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="700" height="26" as="geometry"/></mxCell><mxCell id="c270" value="SERVICIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="900" width="200" height="62" as="geometry"/></mxCell><mxCell id="c271" value="&lt;u&gt;codigo_servicio&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="1120" width="160" height="46" as="geometry"/></mxCell><mxCell id="c272" style="html=1;endArrow=none;" edge="1" parent="1" source="c271" target="c270"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c273" value="puerto_origen" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="1210" width="160" height="46" as="geometry"/></mxCell><mxCell id="c274" style="html=1;endArrow=none;" edge="1" parent="1" source="c273" target="c270"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c275" value="puerto_destino" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1210" width="160" height="46" as="geometry"/></mxCell><mxCell id="c276" style="html=1;endArrow=none;" edge="1" parent="1" source="c275" target="c270"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c277" value="transito_estimado" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1120" width="160" height="46" as="geometry"/></mxCell><mxCell id="c278" style="html=1;endArrow=none;" edge="1" parent="1" source="c277" target="c270"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c279" value="IDENTIFICAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="890" width="165" height="82" as="geometry"/></mxCell><mxCell id="c280" value="RECALADA" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="897" width="215" height="68" as="geometry"/></mxCell><mxCell id="c281" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;fecha_arribo&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="1050" width="170" height="46" as="geometry"/></mxCell><mxCell id="c282" style="html=1;endArrow=none;" edge="1" parent="1" source="c281" target="c280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c283" value="hora_arribo" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1110" width="160" height="46" as="geometry"/></mxCell><mxCell id="c284" style="html=1;endArrow=none;" edge="1" parent="1" source="c283" target="c280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c285" value="estado" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="1050" width="160" height="46" as="geometry"/></mxCell><mxCell id="c286" style="html=1;endArrow=none;" edge="1" parent="1" source="c285" target="c280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c287" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c270" target="c279"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c288" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c279" target="c280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c289" value="TRANSBORDAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="850" width="175" height="95" as="geometry"/></mxCell><mxCell id="c290" value="rol recalada_origen  (1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c280" target="c289"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c291" value="rol recalada_destino  (N) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c289" target="c280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c292" value="&lt;b&gt;Cual se transforma y por que&lt;/b&gt;&lt;br&gt;Lo que obliga a transformar no es que la relacion sea recursiva, sino su &lt;b&gt;cardinalidad&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;SUPERVISAR es M:N&lt;/b&gt; y ademas tiene un atributo propio (periodo). Una relacion N:M no sobrevive al modelo transformado, sea recursiva o no. Se convierte en la entidad debil SUPERVISION, con dos relaciones 1:N hacia OPERARIO, conservando los nombres de rol &lt;b&gt;supervisor&lt;/b&gt; y &lt;b&gt;supervisado&lt;/b&gt; sobre las lineas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Donde queda periodo.&lt;/b&gt; Como atributo de SUPERVISION, y ademas &lt;b&gt;forma parte de su clave&lt;/b&gt;. El enunciado dice que un operario puede ser supervisado por distintos operarios en periodos distintos: sin periodo, dos supervisiones de la misma pareja en epocas distintas serian indistinguibles. Por eso se dibuja con subrayado punteado, como clave parcial.&lt;br&gt;&lt;br&gt;&lt;b&gt;TRANSBORDAR es 1:N&lt;/b&gt; y no tiene atributos propios. Las relaciones binarias 1:N son exactamente lo que el modelo transformado admite, asi que pasa tal cual, con sus roles recalada_origen y recalada_destino y participacion parcial en ambos extremos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Importante.&lt;/b&gt; En el modelo transformado NO se dibuja una clave foranea como atributo. La clave foranea es un elemento del modelo relacional, no del entidad-relacion. Aqui la relacion se representa con su rombo y sus roles; la FK aparecera despues, al pasar a tablas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="600" height="900" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>