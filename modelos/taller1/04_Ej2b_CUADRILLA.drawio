;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c110" target="c111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c120" value="PERTENECER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="560" width="165" height="82" as="geometry"/></mxCell><mxCell id="c121" value="CUADRILLA" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="760" width="215" height="68" as="geometry"/></mxCell><mxCell id="c122" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c111" target="c120"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c123" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c120" target="c121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c124" value="turno" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="950" width="160" height="46" as="geometry"/></mxCell><mxCell id="c125" style="html=1;endArrow=none;" edge="1" parent="1" source="c124" target="c121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c126" value="horas_trabajadas" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="950" width="160" height="46" as="geometry"/></mxCell><mxCell id="c127" style="html=1;endArrow=none;" edge="1" parent="1" source="c126" target="c121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c128" value="OPERARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="200" height="62" as="geometry"/></mxCell><mxCell id="c129" value="&lt;u&gt;id_operario&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="160" height="46" as="geometry"/></mxCell><mxCell id="c130" style="html=1;endArrow=none;" edge="1" parent="1" source="c129" target="c128"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c131" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="160" height="46" as="geometry"/></mxCell><mxCell id="c132" style="html=1;endArrow=none;" edge="1" parent="1" source="c131" target="c128"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c133" value="licencia_portuaria" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="990" width="160" height="46" as="geometry"/></mxCell><mxCell id="c134" style="html=1;endArrow=none;" edge="1" parent="1" source="c133" target="c128"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c135" value="PARTICIPAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="750" width="165" height="82" as="geometry"/></mxCell><mxCell id="c136" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c128" target="c135"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c137" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c135" target="c121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c138" value="Clave de CUADRILLA: &lt;b&gt;id_operario + codigo_servicio + fecha_arribo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="870" width="480" height="30" as="geometry"/></mxCell><mxCell id="c139" value="&lt;b&gt;Regla aplicada.&lt;/b&gt; La misma del punto 2a: la relacion N:M CUADRILLA se convierte en entidad debil, con dos relaciones 1:N hacia OPERARIO y RECALADA. Clave: &lt;b&gt;id_operario + codigo_servicio + fecha_arribo&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt; OPERARIO (1) parcial - CUADRILLA (N) total; RECALADA (1) parcial - CUADRILLA (N) total.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que turno y horas_trabajadas no caben en OPERARIO ni en RECALADA&lt;/b&gt;&lt;br&gt;Porque no describen al operario ni a la recalada por separado: describen &lt;b&gt;el cruce&lt;/b&gt; entre los dos. Su valor solo queda determinado cuando se fijan ambos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ejemplo concreto.&lt;/b&gt; El operario 101 trabaja el 12/05 en la recalada A en turno noche, 6 horas; y el 13/05 en la recalada B en turno dia, 8 horas.&lt;br&gt;&#8226; Como atributos de OPERARIO: el operario 101 tendria un solo turno y un solo total de horas. Se &lt;b&gt;perderia&lt;/b&gt; uno de los dos registros.&lt;br&gt;&#8226; Como atributos de RECALADA: la recalada A tendria un unico turno para toda la cuadrilla. Se &lt;b&gt;perderia&lt;/b&gt; la diferencia entre operarios, y el dato se &lt;b&gt;duplicaria&lt;/b&gt; al repetirse identico por cada operario asignado.&lt;br&gt;&lt;br&gt;En ambos casos el modelo deja de poder responder 'cuantas horas trabajo el operario 101 en la recalada A'." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="160" width="580" height="820" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>