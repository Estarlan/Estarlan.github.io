<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="02-Ej1b_sede_de_CONTRA" name="02-Ej1b sede de CONTRATISTA"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c40" value="Ejercicio 1b - sede de CONTRATISTA: multivaluado y compuesto a la vez" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c41" value="CONTRATISTA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="200" height="62" as="geometry"/></mxCell><mxCell id="c42" value="&lt;u&gt;nit&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="160" height="46" as="geometry"/></mxCell><mxCell id="c43" style="html=1;endArrow=none;" edge="1" parent="1" source="c42" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="razon_social" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="160" height="46" as="geometry"/></mxCell><mxCell id="c45" style="html=1;endArrow=none;" edge="1" parent="1" source="c44" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="UBICAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="578" y="540" width="165" height="82" as="geometry"/></mxCell><mxCell id="c47" value="SEDE_CONTRATISTA" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="730" width="215" height="68" as="geometry"/></mxCell><mxCell id="c48" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;ciudad&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="690" width="170" height="46" as="geometry"/></mxCell><mxCell id="c49" style="html=1;endArrow=none;" edge="1" parent="1" source="c48" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="&lt;u style=&quot;text-decoration:underline dashed&quot;&gt;direccion&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="800" width="170" height="46" as="geometry"/></mxCell><mxCell id="c51" style="html=1;endArrow=none;" edge="1" parent="1" source="c50" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c41" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="sede desaparece de CONTRATISTA: primero se extrae por ser multivaluado,&lt;br&gt;despues se descompone en ciudad y direccion dentro de la nueva entidad." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="900" width="560" height="60" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Orden de aplicacion&lt;/b&gt;&lt;br&gt;&lt;b&gt;Paso 1 - multivaluado.&lt;/b&gt; sede sale de CONTRATISTA y se convierte en la entidad debil SEDE_CONTRATISTA, unida por la relacion 1:N UBICAR.&lt;br&gt;&lt;b&gt;Paso 2 - compuesto.&lt;/b&gt; Ya dentro de esa entidad, sede se descompone en ciudad y direccion.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que el orden inverso NO es equivalente.&lt;/b&gt; Si primero se descompone, quedan dos multivaluados independientes dentro de CONTRATISTA: ciudad y direccion. Al extraerlos despues se obtienen dos entidades separadas y se pierde el vinculo entre cada ciudad y su direccion: el modelo ya no sabe que 'Bogota' va con 'Calle 100' y 'Cali' con 'Av 6'. Se genera un producto cartesiano de valores que no existia en el modelo original.&lt;br&gt;&lt;br&gt;&lt;b&gt;Clave.&lt;/b&gt; Parcial: (ciudad, direccion). Completa: &lt;b&gt;nit + ciudad + direccion&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad y participacion.&lt;/b&gt; CONTRATISTA (1) parcial - SEDE_CONTRATISTA (N) total." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="160" width="540" height="620" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>