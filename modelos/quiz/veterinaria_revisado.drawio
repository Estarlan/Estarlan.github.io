lor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="940" width="160" height="44" as="geometry"/></mxCell><mxCell id="q43" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="q42" target="q5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q44" value="tarjeta_profesional" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="880" width="160" height="44" as="geometry"/></mxCell><mxCell id="q45" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="q44" target="q5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q46" value="Qué cambié frente a la hoja del quiz:&lt;br&gt;1. nombres y apellidos quedan como atributos compuestos (primer/segundo).&lt;br&gt;2. edad es derivado de fecha_nacimiento: elipse punteada.&lt;br&gt;3. Relaciones en infinitivo: TENER y ATENDER.&lt;br&gt;4. razon_consulta y la fecha de la consulta no son de la mascota: describen el cruce MASCOTA-VETERINARIO, así que van en la relación M:N ATENDER.&lt;br&gt;5. fecha_ultima_consulta sobra: sale del MAX(fecha_consulta) de ATENDER (sería derivado).&lt;br&gt;Doble línea = participación total (no hay mascota sin dueño)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;dashed=1;rounded=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="560" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>